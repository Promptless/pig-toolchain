#!/bin/sh
# Only platform dispatch belongs in the launcher; all runtime logic is Go.
set -eu
case "$(/usr/bin/uname -s)" in
  Darwin) runtime_os=darwin ;;
  Linux) runtime_os=linux ;;
  MINGW*|MSYS*|CYGWIN*) exec "${0%/*}/promptless-host-runtime.exe" "$@" ;;
  *) echo 'Unsupported Promptless runtime operating system' >&2; exit 1 ;;
esac
case "$(/usr/bin/uname -m)" in
  x86_64|amd64) runtime_arch=amd64 ;;
  aarch64|arm64) runtime_arch=arm64 ;;
  *) echo 'Unsupported Promptless runtime architecture' >&2; exit 1 ;;
esac
exec "${0%/*}/native/$runtime_os-$runtime_arch/promptless-host-runtime" "$@"
