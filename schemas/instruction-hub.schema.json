{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.promptless.ai/instruction-hub.schema.json",
  "title": "Promptless Instruction Hub Config",
  "type": "object",
  "additionalProperties": false,
  "required": ["org", "marketplace", "version"],
  "properties": {
    "org": {
      "type": "string",
      "minLength": 1
    },
    "marketplace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9]\\d*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
    },
    "stable_plugins": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
      },
      "contains": {
        "const": "pig"
      },
      "uniqueItems": true,
      "default": ["pig"]
    },
    "trace_ingestion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "worker_base_url": {
          "$ref": "#/$defs/https_origin"
        },
        "dashboard_base_url": {
          "$ref": "#/$defs/https_origin"
        },
        "hosted_api_base_url": {
          "$ref": "#/$defs/https_origin"
        }
      },
      "default": {"enabled": false}
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": ["claude", "codex", "gemini", "cursor"]
      },
      "uniqueItems": true,
      "default": ["claude", "codex", "gemini", "cursor"]
    }
  },
  "$defs": {
    "https_origin": {
      "type": ["string", "null"],
      "pattern": "^https://(?:[A-Za-z0-9.-]+|\\[[0-9A-Fa-f:.]+\\])(?::[0-9]+)?/?$",
      "description": "HTTPS origin without credentials, path, query, or fragment. An optional trailing slash is normalized away."
    }
  }
}
